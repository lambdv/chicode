// Shared colors for a minimal, true-black interface.
export global Theme {
    out property <color> background: #000000;
    out property <color> panel: #090909;
    out property <color> hover: #171717;
    out property <color> selected: #202020;
    out property <color> border: #242424;
    out property <color> text: #e6e6e6;
    out property <color> muted: #858585;
    out property <color> accent: #b8b8b8;
}
